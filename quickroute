    4538, 23910, 23911, 7497,
}
DOMESTIC_ASNS.update(range(56040, 56049))


@dataclass
class Hop:
    number: int
    ip: Optional[str]
    asn: Optional[int]
    latency_ms: Optional[float]
    raw: str


@dataclass
class RouteResult:
    city: str
    city_name: str
